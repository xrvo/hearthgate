# Generated by Hearthgate. Do not edit: change hearthgate.yml at home and run `ctl apply`.
name: hearthgate-edge

services:
  tunnel:
    image: {{.ImageWireGuard}}
    cap_add: [NET_ADMIN]
    environment:
      PUID: "${HEARTHGATE_PUID:-1000}"
      PGID: "${HEARTHGATE_PGID:-1000}"
      TZ: Etc/UTC
    labels:
      io.hearthgate.config-hash: "{{.EdgeHash}}"
    sysctls:
      net.ipv4.ip_forward: "0"
    volumes:
      - ./wireguard:/config
    ports:
      - "{{.WireGuardPort}}:51820/udp"
      - "{{.HTTPSPort}}:443"
      - "{{.HTTPPort}}:80"
    networks: [public, agents]
    healthcheck:
      test: ["CMD-SHELL", "ip link show wg0 >/dev/null 2>&1 && iptables -S INPUT 2>/dev/null | grep -q -- '-P INPUT DROP'"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 10s
    restart: unless-stopped

  proxy:
    image: {{.ImageNginx}}
    network_mode: "service:tunnel"
    depends_on:
      tunnel:
        condition: service_healthy
        restart: true
    labels:
      io.hearthgate.config-hash: "{{.EdgeHash}}"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    restart: unless-stopped

networks:
  public: {}
  agents:
    name: hearthgate-agents
    ipam:
      config:
        - subnet: {{.AgentsSubnet}}
