# Generated by Hearthgate. Do not edit: change hearthgate.yml at home and run `ctl deploy`.
name: hearthgate-edge

services:
  # The WireGuard tunnel and the firewall.
  tunnel:
    image: {{.Image}}
    command: tunnel
    cap_add: [NET_ADMIN]
    sysctls:
      net.ipv4.ip_forward: "0"
    labels:
      io.hearthgate.config-hash: "{{.EdgeHash}}"
    volumes:
      - ./tunnel:/etc/hearthgate:ro
    ports:
      - "{{.WireGuardPort}}:51820/udp"
      - "{{.HTTPSPort}}:443"
      - "{{.HTTPPort}}:80"
    networks: [public, agents]
    restart: unless-stopped

  # TCP passthrough to home; shares the tunnel's network, not its keys.
  proxy:
    image: {{.Image}}
    command: nginx
    network_mode: "service:tunnel"
    depends_on:
      tunnel:
        condition: service_healthy
        restart: true
    labels:
      io.hearthgate.config-hash: "{{.EdgeHash}}"
    volumes:
      - ./proxy:/etc/hearthgate:ro
    restart: unless-stopped

networks:
  public: {}
  agents:
    name: hearthgate-agents
    ipam:
      config:
        - subnet: {{.AgentsSubnet}}
