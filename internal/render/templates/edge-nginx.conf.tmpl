# Generated by Hearthgate. Do not edit: change hearthgate.yml at home and run `ctl apply`.
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
	worker_connections 4096;
}

stream {
	proxy_connect_timeout 5s;
	proxy_timeout 1h;

	# Public HTTPS: raw TCP to the home gateway. TLS is not terminated here.
	server {
		listen 443;
		proxy_pass {{.HomeIP}}:443;
		proxy_protocol on;
	}
{{- if .Agents}}

	# Agents: reachable on the tunnel address only, resolved through Docker DNS
	# at connect time so a missing agent does not stop the proxy from starting.
	resolver 127.0.0.11 valid=10s ipv6=off;
	map $server_port $agent_upstream {
{{- range .Agents}}
		{{.Listen}} "{{.Target}}"; # {{.Name}}
{{- end}}
	}
{{- range .Agents}}
	server {
		listen {{$.EdgeIP}}:{{.Listen}};
		proxy_pass $agent_upstream;
	}
{{- end}}
{{- end}}
}

http {
	access_log off;
	server_tokens off;

	# Plain HTTP only ever redirects.
	server {
		listen 80 default_server;
		return 301 https://$host{{.RedirectPort}}$request_uri;
	}
}
