# Generated by Hearthgate. Do not edit: change hearthgate.yml and run `ctl apply`.
# wg-quick reads this in the WireGuard container. PreUp loads the firewall
# before keys, peers or addresses are set and before the interface comes up.
[Interface]
Address = {{.HomeIP}}/32
MTU = 1420
PrivateKey = {{.HomePrivate}}
PreUp = sh /config/wg_confs/firewall.sh %i

[Peer]
PublicKey = {{.EdgePublic}}
PresharedKey = {{.Preshared}}
Endpoint = {{.Endpoint}}
AllowedIPs = {{.EdgeIP}}/32
PersistentKeepalive = 25
