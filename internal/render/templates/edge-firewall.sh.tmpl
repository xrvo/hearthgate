#!/bin/sh
# Generated by Hearthgate. Do not edit: change hearthgate.yml at home and run `ctl apply`.
#
# Firewall for the edge tunnel's network namespace. Run by wg-quick (PostUp).
# Default deny. Nothing is forwarded: every flow ends at the proxy in this namespace.
#
# Outbound traffic into the tunnel is deliberately not restricted here. The home
# gateway's own firewall is what protects home, and `ctl check` probes it from
# this side.
set -eu
WG="${1:-wg0}"

iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -F INPUT
iptables -F FORWARD

iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Internet -> edge: WireGuard, and the public HTTP(S) listeners.
iptables -A INPUT ! -i "$WG" -p udp --dport 51820 -j ACCEPT
iptables -A INPUT ! -i "$WG" -p tcp --dport 443 -j ACCEPT
iptables -A INPUT ! -i "$WG" -p tcp --dport 80 -j ACCEPT
{{- range .Agents}}

# Home -> agent "{{.Name}}".
iptables -A INPUT -i "$WG" -s {{$.HomeIP}} -d {{$.EdgeIP}} -p tcp --dport {{.Listen}} -j ACCEPT
{{- end}}

# No IPv6 in this namespace. Ignored where the kernel has IPv6 disabled.
ip6tables -P INPUT DROP 2>/dev/null || true
ip6tables -P FORWARD DROP 2>/dev/null || true
ip6tables -F INPUT 2>/dev/null || true
ip6tables -A INPUT -i lo -j ACCEPT 2>/dev/null || true
