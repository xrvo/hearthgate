# Generated by Hearthgate. Do not edit: change hearthgate.yml and run `ctl apply`.
# Carries connections from hubs on hearthgate-mgmt to agents on the edge.
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
	worker_connections 1024;
}

stream {
	proxy_connect_timeout 5s;
	proxy_timeout 1h;
{{- range .Agents}}

	# agent "{{.Name}}"
	server {
		listen {{$.MgmtIP}}:{{.Listen}};
		proxy_pass {{$.EdgeIP}}:{{.Listen}};
	}
{{- end}}
}
