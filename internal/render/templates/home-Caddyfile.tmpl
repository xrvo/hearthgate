# Generated by Hearthgate. Do not edit: change hearthgate.yml and run `ctl apply`.
{
	admin off
	default_bind {{.HomeIP}}
	auto_https disable_redirects
{{- if .TLSEmail}}
	email {{.TLSEmail}}
{{- end}}
{{- if eq .TLSCA "internal"}}
	local_certs
{{- else}}
	# Port 80 never reaches home, so certificates use the TLS-ALPN challenge.
	cert_issuer acme {
{{- if eq .TLSCA "letsencrypt-staging"}}
		dir https://acme-staging-v02.api.letsencrypt.org/directory
{{- end}}
		disable_http_challenge
	}
{{- end}}
	servers {
		listener_wrappers {
			# Client addresses arrive in a PROXY header, trusted from the edge only.
			proxy_protocol {
				timeout 5s
				allow {{.EdgeIP}}/32
				fallback_policy reject
			}
			tls
		}
	}
}
{{range .Publish}}
{{.Hostname}} {
	reverse_proxy {{.Target}}
}
{{end -}}
