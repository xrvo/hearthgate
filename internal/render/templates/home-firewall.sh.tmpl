#!/bin/sh
# Generated by Hearthgate. Do not edit: change hearthgate.yml and run `ctl apply`.
#
# Firewall for the home gateway's network namespace. The tunnel container runs it
# before the interface comes up.
# Default deny. Nothing is forwarded: every flow ends at a proxy in this namespace.
set -eu
WG="${1:-wg0}"

iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -F INPUT
iptables -F FORWARD
iptables -F OUTPUT

iptables -A INPUT -i lo -j ACCEPT
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Edge -> home: the TLS listener, and nothing else.
iptables -A INPUT -i "$WG" -s {{.EdgeIP}} -d {{.HomeIP}} -p tcp --dport 443 -j ACCEPT
{{- range .Agents}}

# Hubs on hearthgate-mgmt -> agent "{{.Name}}" on the edge.
iptables -A INPUT ! -i "$WG" -s {{$.MgmtSubnet}} -d {{$.MgmtIP}} -p tcp --dport {{.Listen}} -j ACCEPT
iptables -A OUTPUT -o "$WG" -d {{$.EdgeIP}} -p tcp --dport {{.Listen}} -j ACCEPT
{{- end}}

# Home -> edge: replies, plus the agent ports allowed above.
iptables -A OUTPUT -o "$WG" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT -o "$WG" -j DROP

# No IPv6 in this namespace. Ignored where the kernel has IPv6 disabled.
ip6tables -P INPUT DROP 2>/dev/null || true
ip6tables -P FORWARD DROP 2>/dev/null || true
ip6tables -F INPUT 2>/dev/null || true
ip6tables -A INPUT -i lo -j ACCEPT 2>/dev/null || true
